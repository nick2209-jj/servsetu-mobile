{
  "expo": {
    "name": "ServSetu",
    "slug": "servsetu-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./public/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#16324F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ServSetu to detect your service area and nearby technicians."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ServSetu to upload fault photos and KYC verification documents."
        }
      ]
    ]
  }
}